rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function userRef() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userRef().data.role;
    }

    function userSalonId() {
      return userRef().data.salonId;
    }

    function isSuperAdmin() {
      return isAuthenticated() && userRole() == 'super_admin';
    }

    function isSalonOwner() {
      return isAuthenticated() && userRole() == 'salon_owner';
    }

    function isNailTechnician() {
      return isAuthenticated() && (userRole() == 'nail_technician' || userRole() == 'manicure');
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function canReadUserFromSameSalon() {
      return isSalonOwner()
        && resource.data.salonId == userSalonId()
        && (resource.data.role == 'nail_technician' || resource.data.role == 'manicure');
    }

    function selfUserUpdateHasNoSensitiveFieldChange() {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny([
          'uid',
          'email',
          'role',
          'salonId',
          'googleCalendar',
          'twoFactor',
          'createdAt',
          'updatedAt',
        ]);
    }

    function selfUserCreateIsSafe(userId) {
      return isSelf(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role == 'nail_technician'
        && request.resource.data.salonId == null
        && !request.resource.data.keys().hasAny(['twoFactor']);
    }

    function belongsToSalon(salonId) {
      return isAuthenticated() && userSalonId() == salonId;
    }

    function notificationReadUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'read',
          'readAt',
          'updatedAt',
        ])
        && request.resource.data.read == true
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.salonId == resource.data.salonId
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.data == resource.data.data
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /salons/{salonId} {
      allow read: if isSuperAdmin() || belongsToSalon(salonId);
      allow create, update, delete: if isSuperAdmin() || (isSalonOwner() && belongsToSalon(salonId));
    }

    match /users/{userId} {
      allow read: if isSuperAdmin()
        || isSelf(userId)
        || canReadUserFromSameSalon();

      allow create: if selfUserCreateIsSafe(userId);
      allow update: if isSuperAdmin()
        || (isSelf(userId) && selfUserUpdateHasNoSensitiveFieldChange());
      allow delete: if isSuperAdmin();
    }

    match /clients/{clientId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && belongsToSalon(resource.data.salonId));
      allow create: if isSuperAdmin()
        || (isAuthenticated() && belongsToSalon(request.resource.data.salonId));
      allow update, delete: if isSuperAdmin()
        || (isAuthenticated() && belongsToSalon(resource.data.salonId));
    }

    match /appointments/{appointmentId} {
      allow read: if isSuperAdmin()
        || (isAuthenticated() && belongsToSalon(resource.data.salonId))
        || (isNailTechnician() && resource.data.manicureId == request.auth.uid);

      allow create: if isSuperAdmin()
        || (isAuthenticated() && belongsToSalon(request.resource.data.salonId));

      allow update, delete: if isSuperAdmin()
        || (isAuthenticated() && belongsToSalon(resource.data.salonId))
        || (isNailTechnician() && resource.data.manicureId == request.auth.uid);
    }

    match /commands/{commandId} {
      allow read: if isSuperAdmin() || (isAuthenticated() && belongsToSalon(resource.data.salonId));
      allow create: if isSuperAdmin()
        || (isAuthenticated() && belongsToSalon(request.resource.data.salonId));
      allow update, delete: if isSuperAdmin()
        || (isAuthenticated() && belongsToSalon(resource.data.salonId));
    }

    match /notifications/{notificationId} {
      allow read: if isSuperAdmin()
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update: if isAuthenticated() && notificationReadUpdateIsSafe();
      allow create, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /syncQueue/{taskId} {
      allow read, write: if false;
    }

    match /syncQueueDeadLetter/{taskId} {
      allow read, write: if false;
    }
  }
}
